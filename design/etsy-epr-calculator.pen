                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "kGcaz",
                      "name": "“Registration alone is not eno",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "“Registration alone is not enough for certain types of packaging.”",
                      "lineHeight": 1.55,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "OGypp",
                  "name": "Quote",
                  "width": "fill_container",
                  "stroke": "$accent",
                  "strokeWidth": {
                    "left": 3
                  },
                  "strokeAlignment": "inner",
                  "padding": [
                    2,
                    0,
                    2,
                    16
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "x5bhQ3",
                      "name": "“Enter the packaging volumes i",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "“Enter the packaging volumes in kilogrammes to the third decimal point.”",
                      "lineHeight": 1.55,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "HuJ1g",
                  "name": "Quote",
                  "width": "fill_container",
                  "stroke": "$accent",
                  "strokeWidth": {
                    "left": 3
                  },
                  "strokeAlignment": "inner",
                  "padding": [
                    2,
                    0,
                    2,
                    16
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "rGllk",
                      "name": "“A simplified reporting requir",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "“A simplified reporting requirement applies to producers who made available less than 10 tonnes of packaging subject to system participation in Germany for the first time in the previous calendar year: instead of submitting every data report made to the system operator to the LUCID Packaging Register, these producers may submit a year-end volume report bundling all their packaging volume information to the ZSVR by 1 June of the following calendar year.”",
                      "lineHeight": 1.55,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "P6tPc",
                  "name": "Quote",
                  "width": "fill_container",
                  "stroke": "$accent",
                  "strokeWidth": {
                    "left": 3
                  },
                  "strokeAlignment": "inner",
                  "padding": [
                    2,
                    0,
                    2,
                    16
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "pOUtm",
                      "name": "“Whenever a company reports pa",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "“Whenever a company reports packaging volumes to its system operator, the exact same report must also be filed with the LUCID Packaging Register.”",
                      "lineHeight": 1.55,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "crSbm",
                  "name": "eprkilo does arithmetic on you",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "eprkilo does arithmetic on your export; it does not tell you what you owe or whether you must register.",
