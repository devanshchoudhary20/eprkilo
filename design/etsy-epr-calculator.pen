                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "Zs0Ck",
                      "name": "“Cuando se trate de poca canti",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "“Cuando se trate de poca cantidad puesta en el mercado (menos de 15 t), la única consideración a tener en cuenta es que tendrá que realizar una declaración simplificada en lugar de la habitual, pero debe registrarse y cumplir con las correspondientes obligaciones de información anual.”",
                      "lineHeight": 1.55,
                      "fontFamily": "$font-body",
